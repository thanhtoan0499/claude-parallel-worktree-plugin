# Copy this file to ~/.config/board-mirror/env (chmod 600) and fill in real values there.
# Never commit the filled-in copy — that file lives outside this repo entirely.

# The board artifact published from bin/board.html with capabilities {db: {}}.
ARTIFACT_URL=https://claude.ai/code/artifact/REPLACE-WITH-YOUR-ARTIFACT-ID

# Absolute path to the aiquinta-platform checkout board_state.py should join session data
# against. Unset, board_state.py silently nulls branch/worktree/short_id/ado_refs on every
# session document instead of failing — see bin/board-mirror.md for the full story.
PWT_REPO_ROOT=/absolute/path/to/aiquinta-platform

# Only needed if one person holds more than one ADO identity. Comma-separated. Unset falls back
# to WIQL's @Me, which silently omits tickets assigned to any other identity of the same person.
#PWR_ADO_ASSIGNED_TO=

# MANDATORY. Without this, `claude -p` runs with no Artifact tool in its tool list at all — not a
# denied permission, the tool plain doesn't exist for that session — so every refresh dies at the
# write step with the misleading "Artifact tool is not available in this session". Found by
# bisecting 27 CLAUDE_* vars against a real `claude -p` run: this one, and only this exact value
# (`cli` does NOT work), makes Artifact appear.
CLAUDE_CODE_ENTRYPOINT=claude-desktop
